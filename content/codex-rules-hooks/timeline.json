        "id": "10",
        "chapter": "避坑",
        "narration": [
          "最后记住和 Claude Code 的六个反直觉差异：timeout 单位是秒，改文件工具叫 apply_patch。",
          "还有哈希信任、同事件并发、block 续轮，以及用 git 根拼绝对路径，别照抄踩坑。"
        ],
        "type": "grid",
        "title": "对比 Claude Code **6 大差异**",
        "columns": 3,
        "cards": [
          {
            "tag": "01",
            "title": "timeout 是秒",
            "desc": "不是毫秒，默认 600 秒"
          },
          {
            "tag": "02",
            "title": "apply_patch",
            "desc": "改文件真实 tool_name"
          },
          {
            "tag": "03",
            "title": "/hooks 信任",
            "desc": "非托管钩子签字才跑",
            "featured": true
          },
          {
            "tag": "04",
            "title": "同事件并发",
            "desc": "拦截钩子不阻挡同级钩子"
          },
          {
            "tag": "05",
            "title": "block 是续轮",
            "desc": "Stop 里 block 让它再跑一轮",
            "featured": true
          },
          {
            "tag": "06",
            "title": "git 根拼路径",
            "desc": "别写相对路径防子目录失效"
          }
        ]
      },
